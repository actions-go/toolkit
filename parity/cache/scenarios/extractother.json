[
  {"name": "extract7z is not supported outside Windows", "requires": ["posix"],
   "src": [{"path": "a.7z", "content": "not an archive"}],
   "calls": [{"fn": "extract7z", "args": ["{{src}}/a.7z", "{{temp}}/out"]}]},
  {"name": "extract7z system is checked before the file", "requires": ["posix"],
   "calls": [{"fn": "extract7z", "args": ["", "{{temp}}/out"]}]},
  {"name": "extract7z with a 7zr path is not supported either", "requires": ["posix"],
   "src": [{"path": "a.7z", "content": "not an archive"}],
   "calls": [{"fn": "extract7z", "args": ["{{src}}/a.7z", "{{temp}}/out", "/usr/bin/7zr"]}]},
  {"name": "extract7z default destination is not created", "requires": ["posix"],
   "src": [{"path": "a.7z", "content": "not an archive"}],
   "calls": [{"fn": "extract7z", "args": ["{{src}}/a.7z"]}]},
  {"name": "extractXar is not supported outside macOS", "requires": ["posix"],
   "src": [{"path": "a.xar", "content": "not an archive"}],
   "calls": [{"fn": "extractXar", "args": ["{{src}}/a.xar", "{{temp}}/out"]}]},
  {"name": "extractXar system is checked before the file", "requires": ["posix"],
   "calls": [{"fn": "extractXar", "args": ["", "{{temp}}/out"]}]},
  {"name": "extractXar with flags is not supported outside macOS", "requires": ["posix"],
   "src": [{"path": "a.xar", "content": "not an archive"}],
   "calls": [{"fn": "extractXar", "args": ["{{src}}/a.xar", "{{temp}}/out", ["--noop"]]}]},
  {"name": "extractXar default destination is not created", "requires": ["posix"],
   "src": [{"path": "a.xar", "content": "not an archive"}],
   "calls": [{"fn": "extractXar", "args": ["{{src}}/a.xar"]}]},

  {"name": "extractXar simple", "requires": ["darwin", "xar"],
   "src": [{"path": "a.xar", "archive": {"format": "xar", "files": [
     {"name": "a.txt", "content": "hello\n"},
     {"name": "dir/", "type": "dir", "mode": "750"},
     {"name": "dir/b.txt", "content": "b", "mode": "600"},
     {"name": "bin/run.sh", "content": "#!/bin/sh\n", "mode": "755"}]}}],
   "calls": [{"fn": "extractXar", "args": ["{{src}}/a.xar", "{{temp}}/out"]}]},
  {"name": "extractXar default destination", "requires": ["darwin", "xar"],
   "src": [{"path": "a.xar", "archive": {"format": "xar", "files": [{"name": "a.txt", "content": "hello\n"}]}}],
   "calls": [{"fn": "extractXar", "args": ["{{src}}/a.xar"]}]},
  {"name": "extractXar nested destination is created", "requires": ["darwin", "xar"],
   "src": [{"path": "a.xar", "archive": {"format": "xar", "files": [{"name": "a.txt", "content": "hello\n"}]}}],
   "calls": [{"fn": "extractXar", "args": ["{{src}}/a.xar", "{{temp}}/x/y/z"]}]},
  {"name": "extractXar debug lists the members", "requires": ["darwin", "xar"],
   "env": {"RUNNER_DEBUG": "1"},
   "src": [{"path": "a.xar", "archive": {"format": "xar", "files": [{"name": "a.txt", "content": "hello\n"}, {"name": "d/b.txt", "content": "b"}]}}],
   "calls": [{"fn": "extractXar", "args": ["{{src}}/a.xar", "{{temp}}/out"]}]},
  {"name": "extractXar repeated flag is dropped", "requires": ["darwin", "xar"],
   "env": {"RUNNER_DEBUG": "1"},
   "src": [{"path": "a.xar", "archive": {"format": "xar", "files": [{"name": "a.txt", "content": "hello\n"}]}}],
   "calls": [{"fn": "extractXar", "args": ["{{src}}/a.xar", "{{temp}}/out", "-v"]}]},
  {"name": "extractXar flags list", "requires": ["darwin", "xar"],
   "src": [{"path": "a.xar", "archive": {"format": "xar", "files": [{"name": "a.txt", "content": "hello\n"}]}}],
   "calls": [{"fn": "extractXar", "args": ["{{src}}/a.xar", "{{temp}}/out", ["-x", "-x"]]}]},
  {"name": "extractXar into existing files overwrites", "requires": ["darwin", "xar"],
   "src": [{"path": "a.xar", "archive": {"format": "xar", "files": [{"name": "a.txt", "content": "new\n"}]}}],
   "temp": [{"path": "out/a.txt", "content": "old\n"}],
   "calls": [{"fn": "extractXar", "args": ["{{src}}/a.xar", "{{temp}}/out"]}]},
  {"name": "extractXar file is required", "requires": ["darwin"],
   "calls": [{"fn": "extractXar", "args": ["", "{{temp}}/out"]}]},
  {"name": "extractXar missing archive", "requires": ["darwin", "xar"],
   "calls": [{"fn": "extractXar", "args": ["{{src}}/missing.xar", "{{temp}}/out"]}]},
  {"name": "extractXar not an archive", "requires": ["darwin", "xar"],
   "src": [{"path": "a.xar", "content": "not an archive"}],
   "calls": [{"fn": "extractXar", "args": ["{{src}}/a.xar", "{{temp}}/out"]}]},
  {"name": "extractXar without xar in PATH", "requires": ["darwin"],
   "env": {"PATH": ""},
   "src": [{"path": "a.xar", "content": "not an archive"}],
   "calls": [{"fn": "extractXar", "args": ["{{src}}/a.xar", "{{temp}}/out"]}]}
]
