[
  {"name": "downloadTool default destination", "calls": [{"fn": "downloadTool", "args": ["{{server}}/file"]}]},
  {"name": "downloadTool custom destination", "calls": [{"fn": "downloadTool", "args": ["{{server}}/file", "{{temp}}/tool.bin"]}]},
  {"name": "downloadTool destination in a new directory", "calls": [{"fn": "downloadTool", "args": ["{{server}}/file", "{{temp}}/a/b/c/tool.bin"]}]},
  {"name": "downloadTool destination outside the temp directory", "calls": [{"fn": "downloadTool", "args": ["{{server}}/file", "{{src}}/elsewhere/tool.bin"]}]},
  {"name": "downloadTool destination in an existing directory", "temp": [{"path": "existing", "dir": true}], "calls": [{"fn": "downloadTool", "args": ["{{server}}/file", "{{temp}}/existing/tool.bin"]}]},
  {"name": "downloadTool nested url path", "calls": [{"fn": "downloadTool", "args": ["{{server}}/dir/nested/file.txt", "{{temp}}/f.txt"]}]},
  {"name": "downloadTool url with a query string", "calls": [{"fn": "downloadTool", "args": ["{{server}}/file?token=abc&x=1", "{{temp}}/f.txt"]}]},
  {"name": "downloadTool empty body", "calls": [{"fn": "downloadTool", "args": ["{{server}}/empty", "{{temp}}/empty"]}]},
  {"name": "downloadTool binary body", "calls": [{"fn": "downloadTool", "args": ["{{server}}/binary", "{{temp}}/binary"]}]},
  {"name": "downloadTool follows a 302 redirect", "calls": [{"fn": "downloadTool", "args": ["{{server}}/redirect", "{{temp}}/f"]}]},
  {"name": "downloadTool follows a 301 then a 302 redirect", "calls": [{"fn": "downloadTool", "args": ["{{server}}/redirect-permanent", "{{temp}}/f"]}]},
  {"name": "downloadTool follows a 307 redirect", "calls": [{"fn": "downloadTool", "args": ["{{server}}/redirect-307", "{{temp}}/f"]}]},
  {"name": "downloadTool redirect with a relative location", "calls": [{"fn": "downloadTool", "args": ["{{server}}/redirect-relative", "{{temp}}/f"]}]},
  {"name": "downloadTool redirect loop", "calls": [{"fn": "downloadTool", "args": ["{{server}}/redirect-loop", "{{temp}}/f"]}]},
  {"name": "downloadTool connection refused", "calls": [{"fn": "downloadTool", "args": ["http://127.0.0.1:1/file", "{{temp}}/f"]}]},
  {"name": "downloadTool redirect to a missing resource", "calls": [{"fn": "downloadTool", "args": ["{{server}}/redirect-to-404", "{{temp}}/f"]}]},
  {"name": "downloadTool 404", "calls": [{"fn": "downloadTool", "args": ["{{server}}/404", "{{temp}}/f"]}]},
  {"name": "downloadTool 404 with default destination", "calls": [{"fn": "downloadTool", "args": ["{{server}}/404"]}]},
  {"name": "downloadTool 400", "calls": [{"fn": "downloadTool", "args": ["{{server}}/400", "{{temp}}/f"]}]},
  {"name": "downloadTool 401", "calls": [{"fn": "downloadTool", "args": ["{{server}}/401", "{{temp}}/f"]}]},
  {"name": "downloadTool 403", "calls": [{"fn": "downloadTool", "args": ["{{server}}/403", "{{temp}}/f"]}]},
  {"name": "downloadTool 408 is retried", "calls": [{"fn": "downloadTool", "args": ["{{server}}/408", "{{temp}}/f"]}]},
  {"name": "downloadTool 429 is retried", "calls": [{"fn": "downloadTool", "args": ["{{server}}/429", "{{temp}}/f"]}]},
  {"name": "downloadTool 500 is retried", "calls": [{"fn": "downloadTool", "args": ["{{server}}/500", "{{temp}}/f"]}]},
  {"name": "downloadTool 503 is retried", "calls": [{"fn": "downloadTool", "args": ["{{server}}/503", "{{temp}}/f"]}]},
  {"name": "downloadTool 204", "calls": [{"fn": "downloadTool", "args": ["{{server}}/204", "{{temp}}/f"]}]},
  {"name": "downloadTool 206", "calls": [{"fn": "downloadTool", "args": ["{{server}}/206", "{{temp}}/f"]}]},
  {"name": "downloadTool destination already exists", "temp": [{"path": "tool.bin", "content": "previous"}], "calls": [{"fn": "downloadTool", "args": ["{{server}}/file", "{{temp}}/tool.bin"]}]},
  {"name": "downloadTool destination is an existing directory", "temp": [{"path": "adir", "dir": true}], "calls": [{"fn": "downloadTool", "args": ["{{server}}/file", "{{temp}}/adir"]}]},
  {"name": "downloadTool twice to the same destination", "calls": [{"fn": "downloadTool", "args": ["{{server}}/file", "{{temp}}/tool.bin"]}, {"fn": "downloadTool", "args": ["{{server}}/file", "{{temp}}/tool.bin"]}]},
  {"name": "downloadTool twice to different destinations", "calls": [{"fn": "downloadTool", "args": ["{{server}}/file", "{{temp}}/one"]}, {"fn": "downloadTool", "args": ["{{server}}/binary", "{{temp}}/two"]}]},
  {"name": "downloadTool a failure leaves earlier downloads alone", "calls": [{"fn": "downloadTool", "args": ["{{server}}/file", "{{temp}}/ok"]}, {"fn": "downloadTool", "args": ["{{server}}/404", "{{temp}}/bad"]}]},
  {"name": "downloadTool then cacheFile", "calls": [{"fn": "downloadTool", "args": ["{{server}}/file", "{{temp}}/download"]}, {"fn": "cacheFile", "args": ["{{temp}}/download", "tool", "tool", "1.2.3", "x64"]}, {"fn": "find", "args": ["tool", "1.2.3", "x64"]}]},
  {"name": "downloadTool then cacheDir", "calls": [{"fn": "downloadTool", "args": ["{{server}}/file", "{{temp}}/dl/tool"]}, {"fn": "cacheDir", "args": ["{{temp}}/dl", "tool", "1.2.3", "x64"]}, {"fn": "findAllVersions", "args": ["tool", "x64"]}]}
]
