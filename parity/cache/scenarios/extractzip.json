   "src": [{"path": "a.zip", "archive": {"format": "zip", "files": [{"name": "a.txt", "content": "hello\n"}]}}],
   "calls": [{"fn": "extractZip", "args": ["{{src}}/a", "{{temp}}/out"]}]},
