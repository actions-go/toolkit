   "src": [{"path": "a.zip", "archive": {"format": "zip", "files": [{"name": "a.txt", "content": "new\n", "mode": "644"}, {"name": "d/", "type": "dir", "mode": "755"}, {"name": "d/e", "content": "new"}]}}],
   "temp": [{"path": "out/a.txt", "content": "old\n", "mode": "600"}, {"path": "out/keep.txt", "content": "keep"}, {"path": "out/d/e", "content": "old", "mode": "600"}, {"path": "out/d/other", "content": "other"}],
   "calls": [{"fn": "extractZip", "args": ["{{src}}/a.zip", "{{temp}}/out"]}]},
