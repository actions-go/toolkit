  {"name": "extractZip an absolute symlink out of the destination", "requires": ["posix", "unzip"],
   "src": [{"path": "a.zip", "archive": {"format": "zip", "files": [{"name": "ok.txt", "content": "ok"}, {"name": "abs", "type": "symlink", "link": "/etc/passwd"}]}}],
