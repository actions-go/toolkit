     {"name": "l", "type": "symlink", "link": "d/a.txt"}]}}],
   "calls": [{"fn": "extractZip", "args": ["{{src}}/a.zip", "{{temp}}/out"]}]},
  {"name": "extractZip missing file", "requires": ["posix", "unzip"],
   "calls": [{"fn": "extractZip", "args": ["{{src}}/missing.zip", "{{temp}}/out"]}]},
