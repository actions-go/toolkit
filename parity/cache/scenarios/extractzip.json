   "temp": [{"path": "out/target", "content": "target"}, {"path": "out/l", "symlink": "target"}],
   "calls": [{"fn": "extractZip", "args": ["{{src}}/a.zip", "{{temp}}/out"]}]},
  {"name": "extractZip modes are kept", "requires": ["posix", "unzip"],
   "src": [{"path": "a.zip", "archive": {"format": "zip", "files": [
