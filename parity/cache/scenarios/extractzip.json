[
  {"name": "extractZip simple", "requires": ["posix", "unzip"],
   "src": [{"path": "a.zip", "archive": {"format": "zip", "files": [
     {"name": "a.txt", "content": "hello\n"},
     {"name": "dir/", "type": "dir", "mode": "750"},
     {"name": "dir/b.txt", "content": "b", "mode": "600"},
     {"name": "bin/run.sh", "content": "#!/bin/sh\n", "mode": "755"},
     {"name": "link", "type": "symlink", "link": "a.txt"},
     {"name": "dir/rel", "type": "symlink", "link": "../a.txt"}]}}],
   "calls": [{"fn": "extractZip", "args": ["{{src}}/a.zip", "{{temp}}/out"]}]},
  {"name": "extractZip default destination", "requires": ["posix", "unzip"],
   "src": [{"path": "a.zip", "archive": {"format": "zip", "files": [{"name": "a.txt", "content": "hello\n"}]}}],
   "calls": [{"fn": "extractZip", "args": ["{{src}}/a.zip"]}]},
  {"name": "extractZip null destination", "requires": ["posix", "unzip"],
   "src": [{"path": "a.zip", "archive": {"format": "zip", "files": [{"name": "a.txt", "content": "hello\n"}]}}],
   "calls": [{"fn": "extractZip", "args": ["{{src}}/a.zip", null]}]},
  {"name": "extractZip nested destination is created", "requires": ["posix", "unzip"],
   "src": [{"path": "a.zip", "archive": {"format": "zip", "files": [{"name": "a.txt", "content": "hello\n"}]}}],
   "calls": [{"fn": "extractZip", "args": ["{{src}}/a.zip", "{{temp}}/x/y/z"]}]},
