     {"name": "r", "content": "r", "mode": "444"},
     {"name": "all", "content": "all", "mode": "777"},
     {"name": "setuid", "content": "su", "mode": "4755"},
     {"name": "rodir/", "type": "dir", "mode": "555"},
     {"name": "sticky/", "type": "dir", "mode": "1777"}]}}],
   "calls": [{"fn": "extractZip", "args": ["{{src}}/a.zip", "{{temp}}/out"]}]},
