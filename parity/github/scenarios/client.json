[
  {"name": "user agent without orchestration id", "kind": "userAgent", "base": "base/1.0"},
  {"name": "user agent without orchestration id or base", "kind": "userAgent"},
  {"name": "user agent with whitespace only orchestration id", "kind": "userAgent", "base": "base/1.0", "env": {"ACTIONS_ORCHESTRATION_ID": " \t "}},
  {"name": "user agent with orchestration id", "kind": "userAgent", "base": "base/1.0", "env": {"ACTIONS_ORCHESTRATION_ID": "abc-123"}},
  {"name": "user agent with orchestration id and no base", "kind": "userAgent", "env": {"ACTIONS_ORCHESTRATION_ID": "abc-123"}},
  {"name": "user agent with empty base", "kind": "userAgent", "base": "", "env": {"ACTIONS_ORCHESTRATION_ID": "abc-123"}},
  {"name": "user agent orchestration id is trimmed", "kind": "userAgent", "base": "b", "env": {"ACTIONS_ORCHESTRATION_ID": "  id1  "}},
  {"name": "user agent orchestration id is sanitised", "kind": "userAgent", "base": "b", "env": {"ACTIONS_ORCHESTRATION_ID": "a b/c.d-e_f:g;h"}},
  {"name": "user agent orchestration id keeps allowed characters", "kind": "userAgent", "base": "b", "env": {"ACTIONS_ORCHESTRATION_ID": "AZaz09_.-"}},
  {"name": "user agent orchestration id with a multi byte character", "kind": "userAgent", "base": "b", "env": {"ACTIONS_ORCHESTRATION_ID": "café"}},
  {"name": "user agent orchestration id with an astral character", "kind": "userAgent", "base": "b", "env": {"ACTIONS_ORCHESTRATION_ID": "x😀y"}},
  {"name": "user agent orchestration id with a byte order mark", "kind": "userAgent", "base": "b", "env": {"ACTIONS_ORCHESTRATION_ID": "﻿id"}},
  {"name": "user agent orchestration id with a next line character", "kind": "userAgent", "base": "b", "env": {"ACTIONS_ORCHESTRATION_ID": "\u0085id"}},
  {"name": "user agent orchestration id with a no break space", "kind": "userAgent", "base": "b", "env": {"ACTIONS_ORCHESTRATION_ID": " id "}},
  {"name": "user agent tag is not added twice", "kind": "userAgent", "base": "b actions_orchestration_id/id1", "env": {"ACTIONS_ORCHESTRATION_ID": "id1"}},
  {"name": "user agent with another tag already present", "kind": "userAgent", "base": "b actions_orchestration_id/other", "env": {"ACTIONS_ORCHESTRATION_ID": "id1"}},
  {"name": "user agent tag found anywhere in the base", "kind": "userAgent", "base": "actions_orchestration_id/id1-extra", "env": {"ACTIONS_ORCHESTRATION_ID": "id1"}},

  {"name": "base url default", "kind": "baseUrl"},
  {"name": "base url from GITHUB_API_URL", "kind": "baseUrl", "env": {"GITHUB_API_URL": "https://ghe.example.com/api/v3"}},
  {"name": "base url from GITHUB_API_URL on a data residency host", "kind": "baseUrl",
    "env": {"GITHUB_API_URL": "https://api.octo.ghe.com", "GITHUB_SERVER_URL": "https://octo.ghe.com"}},
  {"name": "base url with GITHUB_API_URL empty", "kind": "baseUrl", "env": {"GITHUB_API_URL": ""}},
  {"name": "base url ignores GITHUB_SERVER_URL on github.com", "kind": "baseUrl", "env": {"GITHUB_SERVER_URL": "https://github.com"}},
  {"name": "base url ignores GITHUB_SERVER_URL when GITHUB_API_URL is unset", "kind": "baseUrl", "env": {"GITHUB_SERVER_URL": "https://ghe.example.com"}},

  {"name": "request GET sends token authorization", "kind": "request", "token": "tok123", "call": "repos.get",
    "params": {"owner": "octo", "repo": "repo"}, "env": {"GITHUB_API_URL": "{{SERVER}}"}},
  {"name": "request GET base url with a path prefix", "kind": "request", "token": "tok123", "call": "repos.get",
    "params": {"owner": "octo", "repo": "repo"}, "env": {"GITHUB_API_URL": "{{SERVER}}/api/v3"}},
  {"name": "request GET ignores GITHUB_SERVER_URL", "kind": "request", "token": "tok123", "call": "repos.get",
    "params": {"owner": "octo", "repo": "repo"}, "env": {"GITHUB_API_URL": "{{SERVER}}", "GITHUB_SERVER_URL": "https://ghe.example.com"}},
  {"name": "request GET encodes path parameters", "kind": "request", "token": "tok123", "call": "repos.get",
    "params": {"owner": "oc to", "repo": "re/po"}, "env": {"GITHUB_API_URL": "{{SERVER}}"}},
  {"name": "request POST sends a json body", "kind": "request", "token": "tok123", "call": "issues.createComment",
    "params": {"owner": "octo", "repo": "repo", "number": 12, "body": "hello é world"}, "env": {"GITHUB_API_URL": "{{SERVER}}"}},
  {"name": "request user agent carries the orchestration id", "kind": "request", "token": "tok123", "call": "repos.get",
    "params": {"owner": "octo", "repo": "repo"}, "env": {"GITHUB_API_URL": "{{SERVER}}", "ACTIONS_ORCHESTRATION_ID": "abc 123"}},
  {"name": "request user agent without orchestration id", "kind": "request", "token": "tok123", "call": "repos.get",
    "params": {"owner": "octo", "repo": "repo"}, "env": {"GITHUB_API_URL": "{{SERVER}}"}},
  {"name": "request without a token", "kind": "request", "call": "repos.get",
    "params": {"owner": "octo", "repo": "repo"}, "env": {"GITHUB_API_URL": "{{SERVER}}"}}
